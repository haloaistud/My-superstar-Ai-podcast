
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Superstar Broadcast Hub - Professional Streaming Platform</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --secondary-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            --accent-gradient: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            --success-gradient: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
            --warning-gradient: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
            --dark-gradient: linear-gradient(135deg, #0c0c0c 0%, #1a1a2e 50%, #16213e 100%);
            --glass-bg: rgba(255, 255, 255, 0.1);
            --glass-border: rgba(255, 255, 255, 0.2);
            --shadow-primary: 0 8px 32px rgba(102, 126, 234, 0.3);
            --shadow-secondary: 0 8px 32px rgba(240, 147, 251, 0.3);
            --shadow-dark: 0 15px 35px rgba(0, 0, 0, 0.5);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Roboto', sans-serif;
            background: var(--dark-gradient);
            color: #ffffff;
            overflow-x: hidden;
            min-height: 100vh;
            line-height: 1.6;
        }

        .container {
            max-width: 1800px;
            margin: 0 auto;
            padding: 20px;
        }

        /* --- LOGIN SCREEN STYLES --- */
        .login-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }
        
        .login-box {
            background: var(--glass-bg);
            padding: 40px;
            border-radius: 20px;
            backdrop-filter: blur(20px);
            border: 2px solid var(--glass-border);
            box-shadow: var(--shadow-dark);
            width: 90%;
            max-width: 400px;
            text-align: center;
        }

        .login-box h2 {
            font-size: 2em;
            margin-bottom: 25px;
            background: var(--secondary-gradient);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .login-box input[type="text"], .login-box input[type="password"] {
            width: 100%;
            padding: 15px;
            margin-bottom: 15px;
            border: 1px solid var(--glass-border);
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.05);
            color: white;
            font-size: 1em;
            outline: none;
            transition: border-color 0.3s;
        }
        
        .login-box input[type="text"]:focus, .login-box input[type="password"]:focus {
            border-color: #667eea;
        }

        .login-box button {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 10px;
            background: var(--primary-gradient);
            color: white;
            font-size: 1.1em;
            font-weight: 700;
            cursor: pointer;
            transition: opacity 0.3s, transform 0.3s;
        }

        .login-box button:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

        .login-message {
            margin-top: 15px;
            color: #ff6b6b;
            font-size: 0.9em;
            height: 20px;
        }

        /* --- DASHBOARD STYLES (Existing) --- */

        .dashboard-content {
            opacity: 0;
            transition: opacity 0.5s;
        }

        .dashboard-content.logged-in {
            opacity: 1;
        }

        .header {
            text-align: center;
            margin-bottom: 40px;
            padding: 40px;
            background: var(--glass-bg);
            border-radius: 25px;
            backdrop-filter: blur(20px);
            border: 2px solid var(--glass-border);
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow-primary);
        }

        .header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: conic-gradient(from 0deg, transparent, rgba(102, 126, 234, 0.1), transparent, rgba(240, 147, 251, 0.1), transparent);
            animation: rotate 30s linear infinite;
        }

        .header-content {
            position: relative;
            z-index: 2;
        }

        @keyframes rotate {
            100% { transform: rotate(360deg); }
        }

        .logo {
            font-size: 3.5em;
            font-weight: 900;
            margin-bottom: 15px;
            background: linear-gradient(45deg, #ff6b6b, #4ecdc4, #45b7d1, #f9ca24, #e056fd);
            background-size: 300% 300%;
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: gradientShift 4s ease-in-out infinite;
            text-shadow: 0 0 30px rgba(255, 255, 255, 0.5);
        }

        @keyframes gradientShift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        .subtitle {
            font-size: 1.4em;
            opacity: 0.9;
            margin-bottom: 25px;
            font-weight: 300;
        }

        .live-indicator {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: var(--warning-gradient);
            padding: 8px 20px;
            border-radius: 25px;
            font-weight: bold;
            font-size: 0.9em;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.05); opacity: 0.8; }
        }

        .role-selector {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 25px;
            flex-wrap: wrap;
        }

        .role-btn {
            padding: 15px 30px;
            border-radius: 30px;
            border: 2px solid transparent;
            background: var(--glass-bg);
            color: white;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            font-weight: 600;
            font-size: 1em;
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(10px);
        }

        .role-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        .role-btn:hover::before {
            left: 100%;
        }

        .role-btn:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-primary);
        }

        .role-btn.active {
            background: var(--primary-gradient);
            border-color: #4ecdc4;
            box-shadow: var(--shadow-primary);
        }

        .role-btn.broadcaster.active {
            background: var(--secondary-gradient);
            box-shadow: var(--shadow-secondary);
        }

        .role-btn.admin.active {
            background: var(--warning-gradient);
            box-shadow: 0 8px 32px rgba(249, 202, 36, 0.3);
        }

        .main-content {
            display: none;
            animation: fadeIn 0.5s ease-in-out;
        }

        .main-content.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* --- SHARED STYLES --- */
        .section-title {
            font-size: 2.2em;
            font-weight: 700;
            margin: 50px 0 25px 0;
            text-align: center;
            background: var(--accent-gradient);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 10px rgba(79, 172, 254, 0.3);
        }

        .metric-card {
            flex: 1;
            padding: 20px;
            border-radius: 15px;
            text-align: center;
            background-color: rgba(255, 255, 255, 0.08); 
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .metric-value {
            display: block;
            font-size: 2.5em;
            font-weight: 900;
            margin-bottom: 5px;
            background: var(--accent-gradient);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .metric-label {
            font-size: 0.9em;
            opacity: 0.7;
            font-weight: 300;
        }

        /* --- VIEWER DASHBOARD STYLES --- */
        
        .channel-filter-bar {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .filter-btn {
            padding: 10px 20px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            background: var(--glass-bg);
            color: white;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 600;
            font-size: 0.9em;
        }

        .filter-btn:hover {
            background-color: rgba(255, 255, 255, 0.2);
        }

        .filter-btn.active {
            background: var(--primary-gradient);
            border-color: #4facfe;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.5);
        }


        .channels-section {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 25px;
        }

        .channel-card {
            background: var(--glass-bg);
            border-radius: 25px;
            padding: 30px;
            border: 2px solid transparent;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(15px);
        }

        .channel-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            transition: left 0.8s;
        }

        .channel-card:hover::before {
            left: 100%;
        }

        .channel-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: var(--shadow-dark);
        }

        .channel-card.live {
            border-color: #ff6b6b;
            background: linear-gradient(135deg, rgba(255, 107, 107, 0.1), rgba(238, 90, 111, 0.1));
            box-shadow: 0 0 30px rgba(255, 107, 107, 0.3);
        }

        .channel-card.podcast {
            border-color: #e056fd;
            background: linear-gradient(135deg, rgba(224, 86, 253, 0.1), rgba(147, 51, 234, 0.1));
            box-shadow: 0 0 30px rgba(224, 86, 253, 0.3);
        }

        .channel-card.youtube {
            border-color: #ff0000;
            background: linear-gradient(135deg, rgba(255, 0, 0, 0.1), rgba(204, 0, 0, 0.1));
            box-shadow: 0 0 30px rgba(255, 0, 0, 0.3);
        }

        .channel-card.bigo {
            border-color: #00d4ff;
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.1), rgba(0, 150, 200, 0.1)); 
            box-shadow: 0 0 30px rgba(0, 212, 255, 0.3); 
        }

        /* Featured Clips Styles */
        .clips-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
            padding: 0 20px;
        }

        .clip-card {
            background: var(--glass-bg);
            border-radius: 15px;
            overflow: hidden;
            box-shadow: var(--shadow-dark);
            transition: transform 0.3s ease-in-out;
            cursor: pointer;
            backdrop-filter: blur(10px);
        }

        .clip-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
        }

        .clip-thumbnail {
            width: 100%;
            height: 200px; 
            background-size: cover;
            background-position: center;
            position: relative;
            display: flex;
            align-items: flex-end;
            padding: 10px;
        }

        .clip-duration {
            background-color: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 4px 8px;
            border-radius: 5px;
            font-size: 0.8em;
            font-weight: 600;
        }

        .clip-title {
            font-size: 1.2em;
            font-weight: 600;
            padding: 15px 15px 5px;
        }

        .clip-meta {
            font-size: 0.9em;
            opacity: 0.7;
            padding: 0 15px 15px;
        }
        
        /* --- BROADCASTER STUDIO STYLES --- */
        .broadcast-control-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 30px;
            margin-top: 30px;
        }

        .metrics-panel, .health-alerts-panel {
            background: var(--glass-bg);
            border-radius: 20px;
            padding: 30px;
            backdrop-filter: blur(15px);
            border: 1px solid var(--glass-border);
            box-shadow: var(--shadow-dark);
        }

        .metrics-panel h3, .health-alerts-panel h3 {
            font-weight: 700;
            font-size: 1.6em;
            margin-bottom: 20px;
            background: var(--secondary-gradient);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .metric-cards-row {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 30px;
        }

        .health-indicator {
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .health-indicator.good {
            background: rgba(67, 233, 123, 0.15); 
            border: 1px solid #43e97b;
        }
        
        .alert-list h4 {
            font-size: 1.1em;
            font-weight: 600;
            margin-bottom: 10px;
            opacity: 0.9;
        }

        .alert-item {
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 8px;
            font-size: 0.95em;
        }

        .alert-item.tip {
            background-color: rgba(250, 112, 154, 0.15); 
        }
        .alert-item.new-sub {
            background-color: rgba(118, 75, 162, 0.15); 
        }
        .alert-item.host {
            background-color: rgba(79, 172, 254, 0.15); 
        }
        
        .stream-control-buttons {
            display: flex;
            gap: 15px;
        }

        .control-btn {
            flex: 1;
            padding: 15px;
            border: none;
            border-radius: 10px;
            font-size: 1.1em;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            color: white;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .control-btn.start-stream {
            background: linear-gradient(135deg, #ff416c 0%, #ff4b2b 100%);
        }

        .control-btn.title-change {
            background: linear-gradient(135deg, #f9ca24 0%, #fa709a 100%);
        }

        /* Multi-Channel Routing Styles */
        .channel-routing-panel {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .channel-routing-panel h3 {
            font-size: 1.4em;
            margin-bottom: 15px;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .channel-status-row {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .channel-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 15px;
            border-radius: 8px;
            flex: 1;
            min-width: 150px;
            font-size: 0.9em;
            background-color: rgba(255, 255, 255, 0.05);
            transition: background-color 0.3s;
        }

        .channel-item.active {
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .channel-status {
            margin-left: auto;
            font-weight: 600;
        }

        .channel-status.good {
            color: #43e97b; /* Success green */
        }
        .channel-status.warning {
            color: #fee140; /* Warning yellow */
        }
        .channel-status.off {
            color: #ff6b6b; /* Critical red */
        }

        .control-btn.routing-toggle {
            background: var(--primary-gradient);
        }
        
        /* Latency Graph Styles */
        .latency-graph-container {
            margin: 25px 0 30px;
            padding: 15px;
            background-color: rgba(0, 0, 0, 0.3);
            border-radius: 10px;
            position: relative;
        }

        .latency-graph-container h4 {
            font-size: 1.1em;
            margin-bottom: 15px;
            color: #4ecdc4; /* Cyan/Teal for network health */
        }

        .latency-chart-area {
            height: 100px;
            border-left: 2px solid rgba(255, 255, 255, 0.2);
            border-bottom: 2px solid rgba(255, 255, 255, 0.2);
            position: relative;
        }
        
        .graph-line {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 80%;
            background: linear-gradient(to right, #43e97b, #fee140, #ff6b6b);
            opacity: 0.7;
            clip-path: polygon(
                0% 80%, 
                10% 70%, 
                20% 75%, 
                30% 60%, 
                40% 65%, 
                50% 50%, 
                60% 55%, 
                70% 40%, 
                80% 45%, 
                90% 30%, 
                100% 35%, 
                100% 100%, 
                0% 100%
            ); 
        }

        .graph-label-h {
            position: absolute;
            bottom: -20px;
            font-size: 0.7em;
            color: #999;
        }

        .graph-label-h.current {
            right: 0;
            font-weight: 600;
        }

        .latency-reading {
            position: absolute;
            top: 5px;
            right: 5px;
            font-size: 1.5em;
            font-weight: 700;
            color: #
